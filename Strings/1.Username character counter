#include<stdio.h>
int main() {
    char str[50];
    fgets(str,sizeof(str),stdin);
    int count=0;
    for (int i=0;str[i]!='\0';i++) {
        if (str[i]>='A' && str[i]<='Z') {
            count++;
        }
        else if (str[i]>='0' && str[i]<='9') {
            count++;
        }
        else if (str[i]>='a' && str[i]<='z') {
            count++;
        }
        else if (str[i]==' ') {
            count++;
        }
    }
    printf("%d",count);
    return 0;
}

